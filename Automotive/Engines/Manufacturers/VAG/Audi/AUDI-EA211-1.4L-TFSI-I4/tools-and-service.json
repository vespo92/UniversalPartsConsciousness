  "service_operations": {
    "maintenance": {
      "oil_change": {
        "interval_miles": 10000,
        "interval_km": 15000,
        "time_months": 12,
        "oil_specification": "VW 508.00/509.00 or VW 504.00/507.00",
        "oil_viscosity": "0W-20 (508/509) or 5W-30 (504/507)",
        "capacity_liters": 4.3,
        "filter_part": "04E115561H",
        "drain_plug_torque_nm": 30,
        "filter_housing_torque_nm": 25,
        "procedure": [
          "Warm engine to operating temperature",
          "Remove undertray (T25 Torx)",
          "Place drain pan under oil pan",
          "Remove drain plug (13mm socket)",
          "Allow oil to drain completely (10+ minutes)",
          "Remove oil filter housing cap (32mm socket or special tool)",
          "Replace filter element",
          "Inspect and replace drain plug washer",
          "Reinstall drain plug - torque to 30 Nm",
          "Install filter housing cap - torque to 25 Nm",
          "Add 4.0L oil initially",
          "Start engine, check for leaks",
          "Check level, add remaining oil as needed",
          "Reset service indicator via VCDS/OBDeleven"
        ],
        "estimated_time_minutes": 30,
        "difficulty": "Easy"
      },
      "spark_plug_replacement": {
        "interval_miles": 40000,
        "interval_km": 60000,
        "spark_plug_part": "04E905612C (or NGK PFR7S8EG)",
        "spark_plug_gap_mm": 0.7,
        "torque_nm": 22,
        "procedure": [
          "Remove engine cover (pull up)",
          "Disconnect ignition coil connectors",
          "Remove ignition coils (T30 Torx, 1 bolt each)",
          "Use compressed air to clean spark plug wells",
          "Remove spark plugs (16mm thin-wall socket)",
          "Gap new plugs to 0.7mm (0.6mm for tuned engines)",
          "Install new plugs hand-tight, then torque to 22 Nm",
          "Reinstall ignition coils - torque to 10 Nm",
          "Reconnect coil connectors",
          "Reinstall engine cover"
        ],
        "estimated_time_minutes": 45,
        "difficulty": "Easy"
      },
      "air_filter_replacement": {
        "interval_miles": 30000,
        "interval_km": 45000,
        "filter_part": "04E129620A",
        "procedure": [
          "Release airbox clips (spring clips)",
          "Lift airbox lid",
          "Remove old filter element",
          "Clean airbox housing if dirty",
          "Install new filter (correct orientation)",
          "Secure airbox lid and clips"
        ],
        "estimated_time_minutes": 10,
        "difficulty": "Very Easy"
      },
      "timing_belt_replacement": {
        "interval_miles": 80000,
        "interval_km": 130000,
        "kit_part": "04E198119F",
        "includes": [
          "Timing belt",
          "Tensioner",
          "Water pump",
          "Idler pulleys"
        ],
        "special_tools_required": ["T10352", "T10340", "T10492"],
        "procedure": [
          "Remove engine cover and front accessories",
          "Remove serpentine belt",
          "Support engine, remove right engine mount",
          "Remove timing cover",
          "Rotate engine to TDC cylinder 1",
          "Install crankshaft lock pin T10492",
          "Install camshaft alignment tools T10340",
          "Mark timing belt direction if reusing (not recommended)",
          "Release tensioner with T10352",
          "Remove timing belt",
          "Replace water pump and idler pulleys",
          "Install new timing belt following routing diagram",
          "Pre-tension with tensioner tool",
          "Remove locking tools",
          "Rotate engine 2 full revolutions by hand",
          "Verify timing marks align",
          "Reinstall locking tools to verify",
          "Final tensioner adjustment",
          "Reassemble in reverse order",
          "Refill coolant, bleed system",
          "Test drive and recheck"
        ],
        "estimated_time_hours": 4,
        "difficulty": "Advanced",
        "notes": "EA211 uses oil-bath (wet) timing belt - check for oil contamination"
      },
      "coolant_flush": {
        "interval_miles": 60000,
        "interval_km": 90000,
        "coolant_spec": "G13 or G12++",
        "capacity_liters": 5.5,
        "procedure": [
          "Ensure engine is cool",
          "Place drain pan under radiator",
          "Open radiator drain (lower left of radiator)",
          "Remove coolant reservoir cap",
          "Allow system to drain",
          "Close drain",
          "Fill with 50/50 G13 coolant mix",
          "Start engine with heater on full hot",
          "Run until thermostat opens",
          "Top up coolant as air bleeds out",
          "Install reservoir cap",
          "Drive and recheck level when cool"
        ],
        "estimated_time_minutes": 45,
        "difficulty": "Easy"
      }
    },
    "common_repairs": {
      "water_pump_replacement": {
        "symptoms": ["Coolant leak", "Overheating", "Coolant warning"],
        "part_number": "04E121600CM",
        "notes": "Often done with timing belt service",
        "estimated_time_hours": 4,
        "difficulty": "Advanced"
      },
      "diverter_valve_replacement": {
        "symptoms": ["Boost leak", "Whooshing sound", "Reduced power"],
        "part_number": "06H145710G",
        "procedure": [
          "Locate DV on turbo compressor housing",
          "Disconnect electrical connector",
          "Release spring clip or bolts",
          "Remove old DV",
          "Install new DV with new o-ring",
          "Reconnect electrical",
          "Test for boost leaks"
        ],
        "estimated_time_minutes": 30,
        "difficulty": "Easy"
      },
      "ignition_coil_replacement": {
        "symptoms": ["Misfires", "Rough idle", "CEL P0300-P0304"],
        "part_number": "04E905110K",
        "procedure": [
          "Remove engine cover",
          "Disconnect coil connector",
          "Remove T30 bolt",
          "Pull coil straight up",
          "Install new coil",
          "Torque bolt to 10 Nm",
          "Clear fault codes"
        ],
        "estimated_time_minutes": 15,
        "difficulty": "Very Easy"
      },
      "carbon_buildup_cleaning": {
        "symptoms": ["Rough idle", "Hesitation", "Misfires", "Reduced power"],
        "interval_miles": 60000,
        "methods": {
          "walnut_blasting": {
            "description": "Media blasting intake valves with walnut shells",
            "effectiveness": "Excellent",
            "cost_usd": "300-500 (shop labor)",
            "notes": "Requires intake manifold removal"
          },
          "chemical_cleaning": {
            "description": "Chemical soak with CRC GDI Cleaner or similar",
            "effectiveness": "Good for light buildup",
            "cost_usd": "20-50 (DIY)",
            "notes": "Preventive maintenance"
          }
        },
        "difficulty": "Advanced (walnut blasting) / Easy (chemical)",
        "notes": "Common issue with all direct injection engines"
      },
      "turbo_replacement": {
        "symptoms": ["Excessive smoke", "Oil consumption", "No boost", "Shaft play"],
        "part_number": "04E145721T",
        "special_tools": "Torque wrench, new oil feed/return lines recommended",
        "procedure": [
          "Disconnect battery",
          "Remove engine cover and intake tract",
          "Disconnect turbo inlet and outlet pipes",
          "Disconnect oil feed line (banjo bolt)",
          "Disconnect oil return line",
          "Disconnect coolant lines (if applicable)",
          "Disconnect wastegate actuator connector",
          "Remove heat shield",
          "Remove turbo mounting nuts (typically 3x M8)",
          "Carefully remove turbocharger",
          "Clean exhaust manifold mating surface",
          "Install new gasket",
          "Install new turbo - torque nuts to 23 Nm",
          "Use new oil feed/return line seals",
          "Reconnect all lines and connectors",
          "Prime turbo with oil before starting",
          "Start engine, check for leaks",
          "Let idle 5 minutes before boosting"
        ],
        "estimated_time_hours": 3,
        "difficulty": "Intermediate"
      }
    }
  },
  "diagnostic_procedures": {
    "fault_code_groups": {
      "misfires": {
