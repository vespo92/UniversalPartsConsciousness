  "service_operations": {
    "maintenance": {
      "oil_change": {
        "interval_miles": 10000,
        "interval_km": 15000,
        "track_use_interval_miles": 5000,
        "oil_specification": {
          "gen1_gen2": "VW 502.00 or 504/507",
          "gen3_plus": "VW 504/507 or 508/509"
        },
        "oil_viscosity": {
          "gen1_gen2": "5W-40 or 5W-30",
          "gen3_plus": "5W-30 or 0W-20"
        },
        "capacity_liters": {
          "gen1_gen2": 5.0,
          "gen3_plus": 5.8
        },
        "filter_part": {
          "gen1_gen2": "06H115561",
          "gen3": "06K115562"
        },
        "drain_plug_torque_nm": 30,
        "filter_housing_torque_nm": 25,
        "procedure": [
          "Warm engine to operating temperature",
          "Remove undertray (T25/T30 Torx)",
          "Position drain pan under oil pan",
          "Remove drain plug (19mm or hex)",
          "Allow complete drain (10+ minutes)",
          "Remove oil filter cap (32mm socket)",
          "Replace filter element",
          "Inspect and replace drain plug washer",
          "Install drain plug - torque 30 Nm",
          "Install filter cap - torque 25 Nm",
          "Add approximately 5L oil initially",
          "Start engine, check for leaks",
          "Check level, add remaining as needed",
          "Reset service interval via VCDS"
        ],
        "estimated_time_minutes": 30,
        "difficulty": "Easy"
      },
      "spark_plug_replacement": {
        "interval_miles": 40000,
        "interval_km": 60000,
        "tuned_interval_miles": 20000,
        "spark_plug_part": {
          "gen1_gen2": "NGK PFR7S8EG",
          "gen3_is20": "06K905601B or NGK ILKAR8Q7G",
          "gen3_is38": "06K905601D (1 step colder)"
        },
        "gap_mm": {
          "stock": 0.7,
          "tuned": 0.6
        },
        "torque_nm": 25,
        "procedure": [
          "Remove engine cover",
          "Disconnect coil pack connectors (4)",
          "Remove coil packs (T30 bolts)",
          "Blow out spark plug wells with compressed air",
          "Remove spark plugs (16mm thin-wall socket)",
          "Check gap on new plugs (0.7mm stock, 0.6mm tuned)",
          "Install new plugs - hand tight, then torque 25 Nm",
          "Reinstall coil packs - torque 10 Nm",
          "Reconnect connectors",
          "Replace engine cover"
        ],
        "estimated_time_minutes": 45,
        "difficulty": "Easy"
      },
      "dsg_service": {
        "interval_miles": 40000,
        "interval_km": 60000,
        "fluid_spec": {
          "DQ250": "VW G 052 182 A2",
          "DQ381": "VW G 055 529 A2"
        },
        "capacity_liters": {
          "DQ250": 5.7,
          "DQ381": 6.8
        },
        "filter_part": {
          "DQ250": "02E305051C",
          "DQ381": "0GC325443"
        },
        "procedure": [
          "Warm transmission to operating temp",
          "Position drain pan under DSG",
          "Remove drain plug",
          "Remove filter/mechatronic cover",
          "Replace filter",
          "Reinstall cover with new gasket",
          "Install drain plug",
          "Fill through fill plug hole",
          "With engine running, add fluid until overflow",
          "Install fill plug at exactly 35°C fluid temp"
        ],
        "estimated_time_hours": 1.5,
        "difficulty": "Intermediate",
        "notes": "Critical to fill at correct temperature - use VCDS to monitor"
      },
      "timing_chain_service_gen1": {
        "interval": "As needed - check for rattle",
        "critical_for": "Gen1 EA888 (2008-2013)",
        "kit_parts": {
          "chain": "06K109158AD",
          "tensioner": "06K109467K (REVISED)",
          "guides": "06K109469A, 06K109509A",
          "sprockets": "06K109077 (crank), 06K109083 (cam)"
        },
        "special_tools_required": ["T10340", "T10492", "T40070", "T40011"],
        "procedure_summary": [
          "Remove front accessories and covers",
          "Set engine to TDC cylinder 1",
          "Lock crankshaft with T10492",
          "Lock camshafts with T10340",
          "Remove timing cover",
          "Release and remove old tensioner",
          "Remove chain, guides, sprockets",
          "Inspect for wear/stretch",
          "Install new components",
          "Reset tensioner with T40070",
          "Verify timing marks",
          "Rotate engine by hand to verify",
          "Reassemble in reverse order"
        ],
        "estimated_time_hours": 6,
        "difficulty": "Advanced",
        "notes": "ALWAYS use revised tensioner (06K109467K) on Gen1"
      },
      "coolant_flush": {
        "interval_miles": 60000,
        "interval_km": 90000,
        "coolant_spec": "G13 or G12++",
        "capacity_liters": 7.0,
        "procedure": [
          "Ensure engine is cold",
          "Open coolant reservoir cap",
          "Open drain at bottom of radiator",
          "Drain system completely",
          "Close drain",
          "Fill with 50/50 G13 mix",
          "Start engine with heater on max",
          "Run until thermostat opens (check temp)",
          "Top off as air purges",
          "Install cap, drive, recheck when cold"
        ],
        "estimated_time_minutes": 45,
        "difficulty": "Easy"
      },
      "water_pump_replacement": {
        "symptoms": ["Coolant leak", "Overheating", "Coolant warning"],
        "part_numbers": {
          "gen1_gen2": "06H121026DD",
          "gen3": "06L121111J"
        },
        "procedure": [
          "Drain coolant",
          "Remove intake tract for access",
          "Remove thermostat housing bolts",
          "Disconnect hoses and sensor",
          "Remove water pump assembly",
          "Clean mating surfaces",
          "Install new pump with new o-rings",
          "Torque bolts to spec",
          "Refill and bleed coolant",
          "Test for leaks"
        ],
        "estimated_time_hours": 2,
        "difficulty": "Intermediate"
      }
    },
    "common_repairs": {
      "diverter_valve_replacement": {
        "symptoms": ["Boost leak", "Lag", "Whooshing sound", "Limp mode"],
        "part_number": "06H145710G",
        "procedure": [
          "Locate DV on turbo compressor housing",
          "Disconnect electrical connector",
          "Remove mounting bolts or release clip",
          "Pull off old DV",
          "Install new DV with new o-ring",
          "Secure and reconnect electrical"
        ],
        "estimated_time_minutes": 30,
        "difficulty": "Easy"
      },
      "pcv_valve_replacement_gen1_gen2": {
        "symptoms": ["Rough idle", "Oil in intake", "Boost leaks", "Whistle"],
        "part_number": "06H103495AK",
        "procedure": [
          "Remove intake manifold (several bolts and hoses)",
          "Access PCV valve on rear of engine",
          "Remove and replace PCV assembly",
          "Reinstall intake manifold",
          "Clear adaptation values in VCDS"
        ],
        "estimated_time_hours": 2,
        "difficulty": "Intermediate",
        "notes": "Very common failure on Gen1/Gen2 - use OEM replacement"
      },
      "carbon_cleaning_walnut_blast": {
        "affected": "Gen1/Gen2 primarily (Gen3+ has port injection)",
        "symptoms": ["Rough idle", "Hesitation", "Misfires", "Power loss"],
        "interval_miles": 50000,
        "procedure": [
          "Remove intake manifold",
          "Seal cylinders to prevent media entry",
          "Use media blaster with walnut shells",
          "Clean all intake valves thoroughly",
          "Vacuum all media from ports",
          "Reinstall intake manifold",
          "Clear adaptations"
        ],
        "shop_cost_usd": "400-600",
        "estimated_time_hours": 4,
        "difficulty": "Advanced",
        "notes": "Gen3+ dual injection significantly reduces buildup"
      },
      "turbo_replacement": {
        "symptoms": ["Excessive smoke", "Oil consumption", "No boost", "Shaft play", "Turbo noise"],
        "part_numbers": {
          "is20": "06K145874L",
          "is38": "06K145874F"
        },
        "special_notes": "Use new oil feed/return lines recommended",
        "procedure": [
          "Disconnect battery",
          "Remove engine cover and intake tract",
          "Disconnect boost pipes and intercooler hoses",
          "Disconnect oil feed line (banjo bolt)",
          "Disconnect oil return line",
          "Disconnect coolant lines (Gen3)",
          "Disconnect wastegate actuator connector",
          "Remove exhaust downpipe flange bolts",
          "Remove turbo mounting hardware",
          "Carefully remove turbocharger",
          "Clean all mating surfaces",
          "Install new gaskets",
          "Install new turbo with new hardware",
          "Torque all bolts to spec",
          "Use new crush washers on oil lines",
          "Reconnect all lines and connectors",
          "Prime with oil before starting",
          "Start and idle for 5 minutes",
          "Check for leaks before boosting"
        ],
        "estimated_time_hours": 4,
        "difficulty": "Intermediate"
      },
      "is38_swap_on_is20_car": {
        "description": "Golf R turbo swap onto GTI platform",
        "parts_required": [
          "IS38 turbocharger",
          "Turbo gasket (06K253039B)",
          "New oil feed/return line crush washers",
          "ECU tune for IS38"
        ],
        "recommended_supporting_mods": [
          "Upgraded HPFP (Autotech)",
          "Upgraded intercooler",
          "Downpipe",
          "Cold air intake"
        ],
        "procedure": [
          "Follow turbo replacement procedure above",
          "IS38 is direct bolt-on to IS20 location",
          "No physical modifications required",
          "Flash IS38 tune before first drive"
        ],
        "estimated_time_hours": 5,
        "difficulty": "Intermediate",
        "expected_output": "370-400 hp with tune"
      }
    }
  },
  "diagnostic_procedures": {
    "fault_code_groups": {
      "misfires": {
        "codes": ["P0300", "P0301", "P0302", "P0303", "P0304"],
        "common_causes": [
          "Worn/fouled spark plugs",
          "Failed ignition coil",
          "Carbon buildup (Gen1/Gen2)",
          "Fuel injector failure",
          "Low compression",
          "Vacuum leak"
        ],
        "diagnostic_steps": [
          "Read freeze frame data",
          "Inspect spark plugs",
          "Swap coils between cylinders",
          "Check fuel injector balance (VCDS)",
          "Compression test if persistent",
          "Carbon inspection via borescope"
        ]
      },
      "boost_pressure": {
        "codes": ["P0299", "P0234", "P0236", "P2261"],
        "common_causes": [
          "Boost/charge pipe leak",
          "Diverter valve failure",
          "Wastegate actuator fault",
          "Turbo failure",
          "Intercooler leak",
          "N75 solenoid failure"
        ],
        "diagnostic_steps": [
          "Smoke test boost system",
          "Check DV operation",
          "Test wastegate with VCDS output test",
          "Log boost actual vs requested",
          "Inspect turbo for shaft play",
          "Check intercooler for cracks/leaks"
        ]
      },
      "timing_chain": {
        "codes": ["P0016", "P0017", "P0018", "P0019"],
        "common_causes": [
          "Stretched timing chain (Gen1)",
          "Failed tensioner (Gen1)",
          "VVT solenoid failure",
          "Oil contamination"
        ],
        "diagnostic_steps": [
          "Check oil level and condition",
          "Listen for startup rattle",
          "Log cam timing adaptations (VCDS)",
          "Check VVT solenoid operation",
          "Measure chain stretch if accessible"
        ],
        "critical_note": "Gen1 timing chain issues are CRITICAL - do not ignore"
      },
      "fuel_system": {
        "codes": ["P0087", "P0088", "P0089", "P0191", "P2293"],
        "common_causes": [
          "Failing HPFP",
          "Weak LPFP",
          "Fuel pressure sensor fault",
          "Clogged fuel filter",
          "Failing injector"
        ],
        "diagnostic_steps": [
          "Log fuel pressure actual vs requested",
          "Check LPFP voltage under load",
          "Test HPFP output with gauge",
          "Injector balance test",
          "Check fuel filter (if equipped)"
        ]
      }
    },
