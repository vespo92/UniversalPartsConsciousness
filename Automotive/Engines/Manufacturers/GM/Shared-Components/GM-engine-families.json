    "1964": "Pontiac GTO creates muscle car segment with 389ci",
    "1965": "Big Block Chevrolet Mark IV debuts (396ci)",
    "1966": "427ci L88 becomes racing legend",
    "1967": "350ci Small Block introduced, production icon",
    "1970": "LS6 454 (450hp) peak muscle car power, Cadillac 500 largest ever",
    "1970": "Pontiac 455 SD and Olds 455 W-30 performance peaks",
    "1971": "Compression ratios drop for emissions compliance",
    "1975": "Catalytic converters mandate unleaded fuel",
    "1982": "Camaro Z28 returns with Cross-Fire Injection 350",
    "1984": "Buick Grand National turbo V6 outperforms V8s",
    "1985": "Tuned Port Injection (TPI) modernizes Small Block",
    "1992": "LT1 debuts with reverse-flow cooling (300hp)",
    "1997": "LS1 aluminum V8 revolutionizes performance (345hp)",
    "2001": "LS6 in C5 Z06 (385hp, later 405hp)",
    "2006": "LS7 7.0L hand-built engine (505hp)",
    "2009": "LS9 supercharged (638hp) in ZR1",
    "2014": "LT1 with direct injection (455hp)",
    "2015": "LT4 supercharged (650hp) in Z06",
    "2019": "LT5 supercharged (755hp) in ZR1",
    "2023": "LT6 flat-plane crank (670hp) in C8 Z06"
  },

