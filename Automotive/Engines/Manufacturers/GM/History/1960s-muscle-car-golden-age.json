  "era_overview": {
    "description": "The 1960s were the muscle car golden age. GM divisions competed against each other and Detroit rivals in a horsepower war that produced legendary engines and vehicles. The decade saw the birth of the GTO, Camaro, and the most powerful production engines ever offered.",
    "key_themes": [
      "Inter-divisional competition drives innovation",
      "Birth of the muscle car segment (1964 GTO)",
      "Big Block engines reach 450+ horsepower",
      "Pony car wars (Mustang vs Camaro)",
      "Racing programs drive development"
    ],
    "market_conditions": "Baby boomers coming of age, cheap gas, minimal regulations"
  },

