      "1970: Absolute peak of muscle car power",
      "1971: Compression ratio drops begin",
      "1973: Oil crisis changes everything",
      "1975: Catalytic converters mandate unleaded fuel",
      "1979: Performance reaches absolute nadir"
    ],
    "regulatory_impact": {
      "1970_clean_air_act": "Set emission standards beginning 1975",
      "1973_arab_oil_embargo": "Gas shortages, lines at pumps",
      "1975_cafe_standards": "Corporate Average Fuel Economy begins"
    }
  },

