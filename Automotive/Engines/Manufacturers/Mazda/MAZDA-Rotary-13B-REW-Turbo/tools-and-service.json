  "diagnostic_procedures": {
    "compression_test": {
      "procedure": [
        "Warm engine to operating temperature",
        "Disable fuel and ignition systems",
        "Remove all 4 spark plugs",
        "Install rotary compression tester in leading plug hole",
        "Crank engine 8-10 revolutions",
        "Record reading for each face (3 per rotor, 6 total)",
        "Compare readings - max 10% variation"
      ],
      "interpretation": {
        "100-130_psi": "Healthy",
        "85-100_psi": "Worn but serviceable",
        "below_85_psi": "Rebuild required",
        "uneven_faces": "Possible apex seal failure on specific face"
      }
    },
    "boost_leak_test": {
      "procedure": [
        "Remove intake piping at turbo inlet",
        "Install boost leak tester",
        "Pressurize to 15 PSI",
        "Listen/spray for leaks in intercooler piping, couplers, BOV, actuators",
        "Check vacuum lines and solenoids"
      ]
    },
    "sequential_turbo_diagnosis": {
      "symptoms": {
        "no_secondary_engagement": ["Check solenoids", "Check vacuum lines", "Check transition valve", "Check ECU"],
        "harsh_transition": ["Worn transition valve", "Boost leak", "Solenoid issue"],
        "surge": ["Transition timing off", "Intake leak"]
      }
    }
  },

  "service_procedures": {
    "oil_change": {
      "interval_miles": 3000,
      "procedure": [
        "Warm engine to operating temperature",
        "Remove drain plug (14mm)",
        "Drain oil completely",
        "Remove oil filter",
        "Install new filter (hand tight + 3/4 turn)",
        "Install drain plug with new gasket",
        "Fill with 4.7L of 10W-30 or 10W-40",
        "Check level after running 30 seconds"
      ],
      "notes": "Rotaries consume oil by design - 1qt per 3000mi is normal"
    },
    "spark_plug_replacement": {
      "interval_miles": 15000,
      "procedure": [
        "Remove engine cover",
        "Disconnect ignition coil connectors",
        "Remove coil packs",
        "Remove spark plugs with 5/8\" socket",
        "Gap new plugs: Leading 0.8mm, Trailing 1.1mm",
        "Install plugs at 12 ft-lb",
        "Reinstall coils and cover"
      ]
    },
    "coolant_flush": {
      "interval_miles": 30000,
      "capacity_liters": 9.0,
      "procedure": [
        "Allow engine to cool",
        "Remove radiator cap",
        "Open radiator drain",
        "Open engine block drain",
        "Flush with distilled water",
        "Close drains",
        "Fill with 50/50 coolant mix",
        "Bleed air by running engine with cap off until thermostat opens"
      ]
    }
  },

