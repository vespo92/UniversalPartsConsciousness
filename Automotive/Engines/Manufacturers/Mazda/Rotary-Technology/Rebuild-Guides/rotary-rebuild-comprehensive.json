  "when_to_rebuild": {
    "symptoms": [
      "Compression below 85 PSI on any face",
      "More than 15% compression variation between faces",
      "Hard hot starts (flooding)",
      "Excessive blue/white smoke at all temps",
      "Coolant loss without external leak",
      "Metal in oil",
      "Severe power loss"
    ],
    "compression_specs": {
      "healthy": "100-130 PSI per face",
      "marginal": "85-100 PSI",
      "rebuild_required": "Below 85 PSI or >15% variance"
    },
    "compression_test_notes": {
      "tool_required": "ROTARY-SPECIFIC compression tester (not piston type)",
      "procedure": "Warm engine, remove all plugs, test each leading plug hole",
      "reading_interpretation": "3 readings per rotor (6 total for twin-rotor)"
    }
  },

