    "standard_tools": [
      "Complete metric socket and wrench set",
      "Torque wrenches (ft-lb and in-lb)",
      "Pry bars and pullers",
      "Micrometers and calipers",
      "Plastigage for bearing clearance",
      "Seal picks and installation tools",
      "Clean workspace with assembly table"
    ]
  },

  "critical_parts": {
    "apex_seals": {
      "quantity": "6 per engine (3 per rotor)",
      "types": {
        "oem_2mm": "Stock replacement, proven reliability",
        "aftermarket_2mm": "Goopy, Atkins - street performance",
        "aftermarket_3mm": "Race application, requires housing modification"
      },
      "springs": "Replace with seals - one per apex seal",
      "inspection": "Measure height - replace if below 8.4mm"
    },
    "side_seals": {
      "quantity": "24 per engine (12 per rotor)",
      "types": "OEM or quality aftermarket",
      "inspection": "Check for cracks, wear"
    },
    "corner_seals": {
      "quantity": "12 per engine (6 per rotor)",
      "note": "Must match corner seal springs"
    },
    "oil_seals": {
      "quantity": "16 per engine",
      "types": "Inner and outer oil seals"
    },
    "rotor_bearings": {
      "quantity": "4 per engine (2 per rotor)",
      "inspection": "Check for play, scoring"
    },
    "eccentric_shaft_bearings": {
      "main_bearings": "Front, center, rear",
      "inspection": "Plastigage for clearance check"
    },
    "coolant_seals": {
      "o_rings": "All water passage O-rings",
      "critical": "Failure causes coolant in combustion chamber"
    },
    "gaskets": {
      "complete_kit": "All gaskets and seals in one package",
      "sources": "Atkins, Mazdatrix, OEM"
    }
  },

  "disassembly_procedure": {
    "step_1": "Remove engine from vehicle",
    "step_2": "Drain all fluids",
    "step_3": "Remove accessories (alternator, AC, PS pump)",
    "step_4": "Remove intake and exhaust manifolds",
    "step_5": "Remove front cover and eccentric shaft pulley",
    "step_6": "Remove rear housing and stationary gear",
    "step_7": "Remove rear rotor carefully",
    "step_8": "Remove intermediate housing",
    "step_9": "Remove front rotor carefully",
    "step_10": "Remove front side housing",
    "step_11": "Remove eccentric shaft",
    "step_12": "Document everything with photos"
  },

  "inspection_and_measurement": {
    "rotor_housings": {
      "check_for": ["Scoring", "Chatter marks", "Chrome wear", "Coolant passage corrosion"],
      "measurement": "Check for warpage with straight edge",
      "tolerance": "0.05mm maximum warpage"
    },
    "side_housings": {
      "check_for": ["Wear marks from side seals", "Corrosion", "Warpage"],
      "bearing_bores": "Check for wear"
    },
    "rotors": {
      "check_for": ["Apex seal groove wear", "Side seal groove wear", "Bearing journal wear"],
      "measurements": {
        "apex_seal_groove_width": "Check against spec",
        "side_seal_groove_depth": "Check against spec"
      }
    },
    "eccentric_shaft": {
      "check_for": ["Journal wear", "Lobe wear", "Straightness"],
      "runout": "Maximum 0.03mm"
    }
  },

  "assembly_procedure": {
    "cleanliness": "CRITICAL - any debris will cause failure",
    "lubrication": "Use assembly lube on all seals and bearings",
    "step_1": {
      "action": "Install eccentric shaft in front side housing",
      "note": "Ensure bearings are properly lubed"
    },
    "step_2": {
      "action": "Install all seals in front rotor",
      "critical": "Apex seals last, use installer tool"
    },
    "step_3": {
      "action": "Install front rotor onto eccentric shaft",
      "note": "Use alignment pins to protect seals"
    },
    "step_4": {
      "action": "Install front rotor housing",
      "note": "Use dowel pins, lower carefully"
    },
    "step_5": {
      "action": "Install intermediate housing",
      "note": "Stationary gear must be properly aligned"
    },
    "step_6": {
      "action": "Install seals in rear rotor"
    },
    "step_7": {
      "action": "Install rear rotor - 180° from front rotor",
      "note": "Counterweights must be opposite"
    },
    "step_8": {
      "action": "Install rear rotor housing"
    },
    "step_9": {
      "action": "Install rear side housing with stationary gear"
    },
    "step_10": {
      "action": "Install and torque tension bolts",
      "torque": "25 ft-lb in star pattern from center",
      "note": "Multiple passes, work outward"
    },
    "step_11": {
      "action": "Verify free rotation",
      "note": "Engine should rotate smoothly by hand"
    },
    "step_12": {
      "action": "Install front cover and pulley"
    }
  },

  "tension_bolt_sequence": {
    "pattern": "Star pattern from center outward",
    "passes": "At least 3 passes to final torque",
    "torque": {
      "pass_1": "10 ft-lb",
      "pass_2": "18 ft-lb",
      "final": "25 ft-lb (23-26 ft-lb range)"
    },
    "bolt_count": 19,
    "warning": "Uneven torque causes seal failure"
  },

  "break_in_procedure": {
    "first_start": {
      "action": "Prime oil system before first start",
      "run": "Idle for 3-5 minutes, check for leaks",
      "rpms": "Vary between 2000-4000 RPM for 20 minutes"
    },
    "first_50_miles": {
      "oil": "Use conventional oil (not synthetic)",
      "rpms": "Vary RPM constantly, no sustained speeds",
      "load": "Light to moderate throttle only"
    },
    "first_500_miles": {
      "driving": "Continue varying RPM and load",
      "avoid": "No full throttle, no high boost if turbo"
    },
    "after_500_miles": {
      "action": "Change oil to synthetic",
      "compression_test": "Verify proper seal seating",
      "driving": "Normal operation can begin"
    }
  },

