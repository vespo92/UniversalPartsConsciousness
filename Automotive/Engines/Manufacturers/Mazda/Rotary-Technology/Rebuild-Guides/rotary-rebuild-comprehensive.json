        "purpose": "Safely manipulate rotors during assembly",
        "source": "Fabricate or purchase"
      },
      {
        "tool": "Housing alignment pins",
        "purpose": "Prevent seal damage during housing installation",
        "source": "OEM Mazda tool set"
      },
      {
        "tool": "Tension bolt torque wrench",
        "purpose": "Accurate tension bolt torquing",
        "source": "Quality 1/2\" drive torque wrench"
      }
