  "notes": {
    "heritage": "The EJ257 brought STI performance to American shores. While JDM received the high-revving 2.0L EJ207, the US got the torque-monster 2.5L, better suited to American driving conditions and fuel quality.",
    "aftermarket_dominance": "The EJ257 enjoys arguably the largest aftermarket support of any engine. From basic bolt-ons to 1500hp drag builds, every conceivable modification is available.",
    "common_issues": [
      {
        "issue": "Ringland failure",
        "severity": "Critical",
        "cause": "Detonation (knock) from improper tuning, poor fuel, or boost spikes",
        "prevention": "Professional tune, quality fuel, knock monitoring, forged pistons for high boost",
        "notes": "The #1 killer of EJ257 engines"
      },
      {
        "issue": "Spun rod bearing",
        "severity": "Critical",
        "cause": "Oil starvation (hard cornering), high RPM stress, bearing clearances",
        "prevention": "ACL Race bearings, oil pickup baffle, Killer B pickup/baffle, ARP rod bolts"
      },
      {
        "issue": "Head gasket failure",
        "severity": "High",
        "cause": "Uneven torquing, overheating, high boost",
        "prevention": "MLS head gaskets, ARP head studs, proper torque sequence"
      },
      {
        "issue": "Cracked exhaust manifold",
        "severity": "Medium",
        "cause": "Thermal cycling stress on OEM unequal length headers",
        "prevention": "Equal length headers, quality materials"
      },
      {
        "issue": "AVCS solenoid failure",
        "severity": "Medium",
        "cause": "Oil contamination, wear",
        "prevention": "Regular oil changes with quality synthetic"
