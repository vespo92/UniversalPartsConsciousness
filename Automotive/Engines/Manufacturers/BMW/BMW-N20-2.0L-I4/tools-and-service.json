  "timing_chain_replacement_procedure": {
    "warning": "CRITICAL SERVICE - Improper timing chain installation can cause catastrophic engine damage",
    "difficulty": "Advanced - recommended for experienced technicians",
    "time_estimate_hours": "8-12",
    "overview": {
      "when_to_replace": [
        "Rattling noise on cold start (classic symptom)",
        "Timing chain rattle at operating temperature",
        "ISTA shows chain stretch > 2.0mm",
        "Mileage > 80,000 miles on early production (2011-2013)",
        "Preventative replacement at 60,000-80,000 miles recommended"
      ],
      "parts_required": [
        "Complete timing chain kit (chain, tensioner, all guides)",
        "VANOS seals (if removing VANOS units)",
        "Valve cover gasket",
        "Various seals and gaskets"
      ]
    },
    "preparation": {
      "step_1": {
        "action": "Disconnect battery and wait 15 minutes",
        "reason": "Allow high-voltage capacitors to discharge"
      },
      "step_2": {
        "action": "Drain engine coolant",
        "notes": "Save if clean for reuse"
      },
      "step_3": {
        "action": "Remove engine covers, intake components, and accessories as needed for access",
        "includes": [
          "Engine acoustic cover",
          "Air filter housing and intake duct",
          "Charge pipe",
          "Ignition coils and spark plugs"
        ]
      },
      "step_4": {
        "action": "Remove valve cover",
        "torque_sequence": "Reverse of installation sequence",
        "notes": "Replace valve cover gasket during reassembly"
      }
    },
    "timing_chain_removal": {
      "step_5": {
        "action": "Rotate engine to TDC cylinder 1",
        "method": "Use 22mm socket on crankshaft bolt, rotate clockwise",
        "verification": [
          "Camshaft lobes for cylinder 1 pointing up and outward",
          "Timing marks aligned on cam gears"
        ]
      },
      "step_6": {
        "action": "Lock crankshaft at TDC",
        "tool": "Crankshaft locking pin (BMW 11 9 350) through bell housing",
        "critical": "Ensure pin fully engaged before proceeding"
      },
      "step_7": {
        "action": "Lock camshafts using timing tools",
        "tool": "Camshaft locking tools (BMW 11 9 340)",
        "notes": "Install on rear of camshafts"
      },
      "step_8": {
        "action": "Release timing chain tensioner",
        "method": [
          "Remove tensioner access plug",
          "Compress tensioner with tool",
          "Insert locking pin to hold compressed"
        ],
        "caution": "Tensioner is spring-loaded"
      },
      "step_9": {
        "action": "Remove VANOS units",
        "method": [
          "Remove central bolts (Torx E16)",
          "Note position of timing marks",
          "Carefully remove VANOS actuators"
        ],
        "notes": "Keep track of VANOS solenoid orientation"
      },
      "step_10": {
        "action": "Remove timing chain guides",
        "sequence": [
          "Upper chain guide",
          "Lower chain guide (tensioner rail)"
        ],
        "inspection": "Check guides for cracking, wear grooves, breakage"
      },
      "step_11": {
        "action": "Remove timing chain",
        "notes": "Note routing and direction of chain",
        "inspection": [
          "Check for stretched links",
          "Check for damaged rollers",
          "Measure chain stretch if gauge available"
        ]
      }
    },
    "timing_chain_installation": {
      "step_12": {
        "action": "Install new crankshaft sprocket (if replacing)",
        "notes": "Check for wear on teeth"
      },
      "step_13": {
        "action": "Install new timing chain",
        "critical": [
          "Maintain correct chain routing",
          "Ensure chain properly seated on all sprockets",
          "No slack between cam sprockets"
        ]
      },
      "step_14": {
        "action": "Install NEW timing chain guides",
        "components": [
          "Upper chain guide",
          "Lower chain guide (tensioner rail)"
        ],
        "critical": "Always use new guides - never reuse old guides"
      },
      "step_15": {
        "action": "Install NEW timing chain tensioner",
        "method": [
          "Insert tensioner with locking pin in place",
          "Secure mounting bolts",
          "Remove locking pin LAST"
        ],
        "torque": "See torque specifications below"
      },
      "step_16": {
        "action": "Install VANOS units",
        "method": [
          "Align timing marks",
          "Install new seals if removed",
          "Torque central bolts to specification"
        ],
        "critical": "Verify timing marks align before tightening"
      },
      "step_17": {
        "action": "Verify timing",
        "method": [
          "Ensure all timing marks aligned",
          "Camshaft tools should install without resistance",
          "Crankshaft locking pin should engage"
        ],
        "critical": "DO NOT proceed if timing is off - re-check all marks"
      },
      "step_18": {
        "action": "Remove locking tools",
        "sequence": [
          "Remove camshaft locking tools",
          "Remove crankshaft locking pin",
          "Remove tensioner locking pin (if not already done)"
        ]
      },
      "step_19": {
        "action": "Rotate engine by hand 2 full revolutions",
        "method": "Use socket on crankshaft bolt, rotate clockwise slowly",
        "purpose": "Verify no interference, proper chain tension",
        "critical": "STOP IMMEDIATELY if any resistance felt"
      },
      "step_20": {
        "action": "Re-verify timing at TDC",
        "method": "Re-install all locking tools - should fit without resistance",
        "critical": "If tools don't fit, timing is off - must re-do"
      }
    },
    "reassembly": {
      "step_21": {
        "action": "Install new valve cover gasket and valve cover",
        "torque_sequence": "See valve cover torque specification",
        "notes": "Use new gasket - do not reuse"
      },
      "step_22": {
        "action": "Reinstall all removed components",
        "includes": [
          "Ignition coils and spark plugs",
          "Charge pipe",
          "Intake components",
          "Engine covers"
        ]
      },
      "step_23": {
        "action": "Refill coolant and bleed system",
        "method": "Use vacuum fill system or no-spill funnel",
        "notes": "Ensure no air pockets"
      },
      "step_24": {
        "action": "Reconnect battery",
        "notes": "Allow adaptations to reset"
      },
      "step_25": {
        "action": "Start engine and verify operation",
        "checks": [
          "No check engine light",
          "No unusual noises",
          "Smooth idle",
          "No coolant leaks"
        ]
      },
      "step_26": {
        "action": "Clear fault codes and perform adaptations",
        "tool": "ISTA/INPA required",
        "functions": [
          "Clear any stored faults",
          "Perform Valvetronic adaptation if disturbed",
          "Verify timing chain stretch value reset"
        ]
      }
    }
  },

  "valve_cover_gasket_replacement": {
    "difficulty": "Moderate",
    "time_estimate_hours": "2-3",
    "parts_required": [
      "Valve cover gasket (11-12-7-588-412 - updated)",
      "Spark plug tube seals (if separate)",
      "Valve cover bolts (if damaged)"
    ],
    "procedure_overview": [
      "Remove engine covers and intake components",
      "Disconnect ignition coils and remove",
      "Remove valve cover bolts in reverse torque sequence",
      "Remove valve cover",
      "Clean mating surfaces thoroughly",
      "Install new gasket onto valve cover",
      "Install valve cover with new bolts if needed",
      "Torque valve cover bolts in sequence"
    ],
    "torque_spec_nm": 10,
    "torque_sequence": "Start from center, work outward in spiral pattern"
  },

  "water_pump_thermostat_replacement": {
    "difficulty": "Moderate",
    "time_estimate_hours": "2-4",
    "parts_required": [
      "Electric water pump (11-51-7-597-715)",
      "Thermostat (11-53-7-644-811)",
