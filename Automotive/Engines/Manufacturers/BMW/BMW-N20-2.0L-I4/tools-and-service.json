  "spark_plug_replacement": {
    "difficulty": "Easy",
    "time_estimate_hours": "0.5-1",
    "interval_miles": 60000,
    "parts_required": [
      "Spark plugs x4 (NGK SILZKBR8D8S or equivalent)",
      "Anti-seize compound (optional)"
    ],
    "procedure_overview": [
      "Remove engine cover",
      "Disconnect ignition coil connectors",
      "Remove ignition coils",
      "Remove spark plugs with 14mm thin-wall socket",
      "Gap new plugs to 0.8mm (0.032 in)",
      "Install new plugs - hand thread first",
      "Torque spark plugs to specification",
      "Reinstall ignition coils and connect"
    ],
    "torque_nm": 22,
    "torque_lb_ft": 16,
    "notes": [
      "Use 14mm thin-wall spark plug socket with extension",
      "Ensure plugs thread in smoothly by hand before using socket",
      "Do not over-torque - aluminum head is soft"
    ]
  },

  "oil_change_procedure": {
    "difficulty": "Easy",
    "time_estimate_hours": "0.5",
    "interval_miles": {
      "bmw_recommended": 15000,
      "recommended_for_longevity": 7500,
      "severe_service": 5000
    },
    "parts_required": [
      "5.0 liters BMW LL-01 approved oil",
      "Oil filter (11-42-7-640-862)",
      "Drain plug washer (if equipped)"
    ],
    "procedure_overview": [
      "Warm engine to operating temperature",
      "Position drain pan and remove drain plug (17mm)",
      "Allow oil to drain completely (5-10 minutes)",
      "Remove oil filter housing cap (86mm wrench)",
      "Remove old filter element and replace",
      "Install new filter and reinstall housing cap",
      "Install drain plug with new washer",
      "Add 4.5 liters of new oil",
      "Check level, add to bring to full mark",
      "Start engine, check for leaks",
      "Reset oil service indicator"
    ],
    "drain_plug_torque_nm": 25,
    "filter_cap_torque_nm": 25,
    "capacity_liters": 5.0,
    "capacity_quarts": 5.3,
    "service_reset": {
      "method_1": "Through iDrive: Vehicle Info > Vehicle Status > Service Required > Reset",
      "method_2": "Using instrument cluster buttons (varies by year)"
    }
  },

