  "known_issues": {
    "critical_issues": [
      {
        "issue": "VANOS Solenoid Failure",
        "severity": "High",
        "affected_components": ["Intake VANOS solenoid", "Exhaust VANOS solenoid"],
        "symptoms": [
          "Rough idle",
          "Loss of power",
          "Check engine light with VANOS codes",
          "Engine stalling",
          "Poor fuel economy"
        ],
        "common_codes": ["2A82", "2A87", "2A7A", "2A7F"],
        "typical_mileage": "60,000-100,000 miles",
        "repair_cost_usd": "200-600",
        "notes": "Common failure due to oil contamination and wear. Often can be cleaned and reinstalled."
      },
      {
        "issue": "Valve Cover Gasket Leak",
        "severity": "High",
        "affected_components": ["Valve cover gasket", "Valve cover"],
        "symptoms": [
          "Oil smell when engine is hot",
          "Visible oil around valve cover",
          "Oil dripping onto exhaust manifold",
          "Smoke from engine bay"
        ],
        "typical_mileage": "70,000-120,000 miles",
        "repair_cost_usd": "800-1500",
        "notes": "Valve cover is integrated with PCV system and often requires complete replacement. Eccentric shaft sensor is mounted in valve cover."
      },
      {
        "issue": "Electric Water Pump Failure",
        "severity": "Critical",
        "affected_components": ["Electric water pump", "Thermostat housing"],
        "symptoms": [
          "Engine overheating",
          "Coolant warning light",
          "Reduced engine power message",
          "No heat from heater"
        ],
        "common_codes": ["2E81", "2E82", "2E83", "2E84", "2E85"],
        "typical_mileage": "60,000-80,000 miles",
        "repair_cost_usd": "800-1400",
        "notes": "Electric water pump is prone to failure. Should be replaced proactively at 80k miles. Thermostat often replaced at same time."
      },
      {
        "issue": "Oil Filter Housing Gasket Leak",
        "severity": "Medium-High",
        "affected_components": ["Oil filter housing gasket", "Oil cooler gasket"],
        "symptoms": [
          "Oil leak from front of engine",
          "Oil dripping onto alternator",
          "Low oil level warnings"
        ],
        "typical_mileage": "60,000-100,000 miles",
        "repair_cost_usd": "400-800",
        "notes": "Common leak point. Gasket deteriorates due to heat cycling. Can damage alternator if ignored."
      }
    ],
    "common_issues": [
      {
        "issue": "Eccentric Shaft Sensor Failure",
        "severity": "Medium",
        "affected_components": ["Eccentric shaft sensor", "Valvetronic motor"],
        "symptoms": [
          "Rough idle",
          "Limp mode",
          "Check engine light",
          "Reduced power"
        ],
        "common_codes": ["2A67", "2A68", "2764", "2765"],
        "typical_mileage": "80,000-120,000 miles",
        "repair_cost_usd": "500-1200",
        "notes": "Sensor is integrated into valve cover on later models. May require valve cover replacement."
      },
      {
        "issue": "DISA Valve Failure",
        "severity": "Medium",
        "affected_components": ["DISA valve (intake manifold runner control)"],
        "symptoms": [
          "Loss of low-end torque",
          "Rough idle",
          "Check engine light",
          "Rattling noise from intake"
        ],
        "common_codes": ["2776", "2777", "P1520", "P1521"],
        "typical_mileage": "80,000-150,000 miles",
        "repair_cost_usd": "300-600",
        "notes": "Plastic flaps can break and get ingested into engine. Inspect during throttle body service."
      },
      {
        "issue": "Serpentine Belt Tensioner Failure",
        "severity": "Medium",
        "affected_components": ["Belt tensioner", "Idler pulley"],
        "symptoms": [
          "Squealing noise on startup",
          "Belt chirping",
          "AC not working intermittently"
        ],
        "typical_mileage": "80,000-120,000 miles",
        "repair_cost_usd": "200-400",
        "notes": "Tensioner pulley bearings wear out. Replace with belt."
      },
      {
        "issue": "Thermostat Failure",
        "severity": "Medium",
        "affected_components": ["Electric thermostat", "Thermostat housing"],
        "symptoms": [
          "Engine running cold",
          "Poor fuel economy",
          "Slow heater warmup",
          "Check engine light"
        ],
        "common_codes": ["2E8A", "2E8B"],
        "typical_mileage": "60,000-100,000 miles",
        "repair_cost_usd": "400-700",
        "notes": "Electronic thermostat fails either open or closed. Often done with water pump."
      },
      {
        "issue": "PCV Valve/CCV System Failure",
        "severity": "Medium",
        "affected_components": ["Crankcase ventilation valve", "CCV hoses"],
        "symptoms": [
          "Rough idle",
          "Oil consumption",
          "Whistling noise from engine",
          "Check engine light"
        ],
        "typical_mileage": "70,000-100,000 miles",
        "repair_cost_usd": "150-400",
        "notes": "CCV is integrated into valve cover on N52. May require valve cover replacement for complete fix."
      },
      {
        "issue": "Ignition Coil Failure",
        "severity": "Low-Medium",
        "affected_components": ["Ignition coils", "Spark plugs"],
        "symptoms": [
          "Misfire",
          "Rough idle",
          "Check engine light",
          "Reduced power"
        ],
        "common_codes": ["29CC", "29CD", "29CE", "29CF", "29D0", "29D1"],
