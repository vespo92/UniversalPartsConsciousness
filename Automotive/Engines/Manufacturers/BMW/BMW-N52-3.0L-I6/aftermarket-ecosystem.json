    "last_updated": "2025-01-15",
    "notes": "N52 is naturally aspirated with limited performance aftermarket. Focus is on maintenance and reliability."
  },
  "market_overview": {
    "description": "The BMW N52 aftermarket is primarily focused on maintenance, reliability, and OEM-equivalent replacement parts rather than performance modifications. As BMW's last naturally aspirated inline-6, the N52 has a dedicated following of enthusiasts who appreciate its smooth power delivery and relative simplicity compared to turbocharged successors.",
    "market_segments": {
      "maintenance_and_repair": {
        "market_size": "Large",
        "description": "Largest segment - cooling system, gaskets, sensors, and wear items",
        "growth_trend": "Stable"
      },
      "oem_equivalent_parts": {
        "market_size": "Large",
        "description": "OEM supplier parts at lower prices than dealer",
        "growth_trend": "Stable"
      },
      "performance_modifications": {
        "market_size": "Small",
        "description": "Limited market due to NA engine and Valvetronic complexity",
        "growth_trend": "Declining"
      },
      "restoration_and_preservation": {
        "market_size": "Growing",
        "description": "Keeping clean examples running for enthusiasts",
        "growth_trend": "Increasing"
      }
    }
  },
