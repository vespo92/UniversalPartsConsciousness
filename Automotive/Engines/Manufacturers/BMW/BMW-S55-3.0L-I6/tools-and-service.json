  "service_operations": {
    "maintenance": {
      "oil_change": {
        "interval_miles": 5000,
        "bmw_interval_miles": 10000,
        "difficulty": "beginner",
        "time_minutes": 45,
        "tools": [
          "17mm socket or wrench",
          "86mm oil filter wrench",
          "8qt drain pan",
          "Funnel",
          "Torque wrench"
        ],
        "parts": [
          "6.5L BMW LL-01 approved oil",
          "Oil filter (Mann HU816X or equivalent)",
          "Drain plug crush washer"
        ],
        "procedure": [
          "1. Warm engine to operating temperature",
          "2. Lift vehicle and secure on jack stands",
          "3. Remove belly pan (if equipped)",
          "4. Place drain pan under oil pan",
          "5. Remove 17mm drain plug",
          "6. While draining, remove oil filter cap with 86mm wrench",
          "7. Replace filter element and O-rings",
          "8. Install filter cap - torque to 25 Nm",
          "9. Install drain plug with new washer - torque to 25 Nm",
          "10. Fill with 6.5L oil",
          "11. Check level with dipstick",
          "12. Reset oil service indicator via iDrive"
        ],
        "torque_specs": {"drain_plug_nm": 25, "filter_cap_nm": 25}
      },
      "spark_plugs": {
        "interval_miles": 30000,
        "interval_tuned_miles": 15000,
        "difficulty": "intermediate",
        "time_minutes": 90,
        "tools": [
          "14mm thin wall magnetic spark plug socket",
          "T30 Torx driver",
          "6\" and 12\" extensions",
          "Torque wrench (inch-pounds capable)",
          "Compressed air"
        ],
        "parts": [
          "6x NGK 94201 or one step colder for tuned",
          "Dielectric grease"
        ],
        "procedure": [
          "1. Remove engine cover",
          "2. Disconnect ignition coil connectors",
          "3. Remove coil hold-down bolts (T30)",
          "4. Remove ignition coils",
          "5. Use compressed air to clean spark plug wells",
          "6. Remove spark plugs",
          "7. Check gap on new plugs (0.7mm)",
          "8. Install new plugs - hand thread first",
          "9. Torque to 22 Nm",
          "10. Apply dielectric grease to coil boots",
          "11. Reinstall coils and connectors"
        ],
        "torque_specs": {"spark_plug_nm": 22}
      },
      "air_filter_replacement": {
        "interval_miles": 30000,
        "difficulty": "beginner",
        "time_minutes": 20,
        "tools": ["Flathead screwdriver or T25 Torx (depending on airbox)"],
        "parts": ["2x panel air filters"],
        "procedure": [
          "1. Open airbox clips (2 airboxes - driver and passenger)",
          "2. Remove old filters",
          "3. Inspect airbox for debris",
          "4. Install new filters with correct orientation",
          "5. Close and secure airbox lids"
        ]
      },
      "brake_fluid_flush": {
        "interval_miles": 30000,
        "interval_years": 2,
        "difficulty": "intermediate",
        "time_minutes": 60,
        "tools": [
          "Brake bleeder kit or assistant",
          "11mm wrench for bleed nipples",
          "Catch container",
          "Fresh fluid (1L minimum)"
        ],
        "procedure": [
          "1. Remove reservoir cap",
          "2. Use turkey baster to remove old fluid from reservoir",
          "3. Fill with fresh DOT 4 fluid",
          "4. Bleed in sequence: RR, LR, RF, LF",
          "5. For each corner: open bleeder, pump pedal, close bleeder",
          "6. Continue until clear fluid with no bubbles",
          "7. Top off reservoir",
          "8. Test pedal feel"
        ],
        "notes": "DSC pump may need to be bled with BMW scanner"
      },
      "walnut_blasting": {
        "interval_miles": 40000,
        "difficulty": "advanced",
        "time_hours": 4,
        "tools": [
          "Media blaster",
          "Walnut shell media",
          "Shop vacuum with adapter",
          "Intake manifold removal tools",
          "Borescope for inspection"
        ],
        "notes": [
          "Direct injection causes carbon buildup on intake valves",
          "Requires intake manifold removal",
          "Professional service recommended",
