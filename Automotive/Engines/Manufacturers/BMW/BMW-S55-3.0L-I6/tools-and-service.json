  "diagnostic_procedures": {
    "boost_leak_test": {
      "tools": ["Boost leak tester", "Shop air (max 20 psi)"],
      "procedure": [
        "1. Attach tester to intake after MAF",
        "2. Cap or plug all vacuum lines",
        "3. Pressurize system to 15-20 psi",
        "4. Listen and feel for leaks",
        "5. Use soapy water on connections to find small leaks"
      ],
      "common_leak_points": [
        "Charge pipe connections",
        "Intercooler end tanks",
        "Diverter valve seals",
        "Intake manifold gasket",
        "Throttle body gasket"
      ]
    },
    "compression_test": {
      "tools": ["Compression tester", "14mm adapter"],
      "procedure": [
        "1. Warm engine to operating temperature",
        "2. Remove all spark plugs",
        "3. Disable fuel system and ignition",
        "4. Install compression gauge in cylinder 1",
        "5. Crank engine for 5-6 compression strokes",
        "6. Record reading",
        "7. Repeat for all cylinders"
      ],
      "specifications": {
        "minimum_bar": 10,
        "minimum_psi": 145,
        "max_variation_percent": 10
      },
      "interpretation": {
        "low_all_cylinders": "Worn rings or timing issue",
        "low_one_cylinder": "Valve or head gasket issue",
        "low_adjacent_cylinders": "Head gasket failure between cylinders"
      }
    },
    "oil_pressure_test": {
      "tools": ["Mechanical oil pressure gauge", "Adapter for oil pressure sender port"],
      "specifications": {
        "idle_warm_bar": "1.0 minimum",
        "3000rpm_bar": "3.0-5.0",
        "redline_bar": "4.0-6.0"
      },
      "low_pressure_causes": [
        "Worn bearings",
        "Oil pump wear",
        "Oil pump chain stretch",
        "Wrong viscosity oil",
        "Low oil level"
      ]
    },
    "rod_bearing_inspection": {
      "method": "Oil analysis",
      "procedure": [
        "1. Take oil sample at each oil change",
        "2. Send to Blackstone Labs or equivalent",
        "3. Monitor copper and lead levels",
        "4. Elevated metals indicate bearing wear"
      ],
      "warning_levels": {
        "copper_ppm": ">30 indicates concern",
        "lead_ppm": ">15 indicates concern"
      },
      "notes": "Best way to catch bearing wear early"
    },
    "crank_hub_inspection": {
      "symptoms_of_failure": [
        "Intermittent no-start",
        "Timing constantly changing",
        "Multiple misfire codes",
        "Strange engine noise/vibration"
      ],
      "inspection_method": [
        "1. Mark crank pulley and timing cover",
        "2. Run engine under load (dyno ideal)",
        "3. Check if marks have moved",
        "4. Any movement indicates slipped hub"
      ],
      "notes": "Fix preemptively - inspection often occurs after failure"
    }
  },

