  "service_operations": {
    "routine_maintenance": [
      {
        "operation": "Oil Change",
        "interval": "3,000 miles or 3 months",
        "time_estimate": "30 minutes",
        "difficulty": "Easy",
        "procedure": [
          "Warm engine to operating temperature",
          "Position drain pan under oil pan drain plug",
          "Remove drain plug (1/2-20 thread)",
          "Allow oil to drain completely (10 minutes)",
          "Replace drain plug with new copper washer",
          "Remove and replace oil filter element (canister type)",
          "Add 5 quarts of 20W-50 or 10W-40 oil with ZDDP",
          "Start engine and check for leaks",
          "Verify oil level on dipstick"
        ],
        "notes": "Use ZDDP-enhanced oil for flat tappet camshaft protection"
      },
      {
        "operation": "Spark Plug Replacement",
        "interval": "10,000 miles",
        "time_estimate": "1 hour",
        "difficulty": "Easy",
        "procedure": [
          "Allow engine to cool completely",
          "Remove spark plug wires one at a time (note firing order)",
          "Use 13/16\" spark plug socket to remove plugs",
          "Inspect old plugs for condition (reading)",
          "Gap new plugs to 0.035\"",
          "Install new plugs hand-tight, then torque to 25 ft-lbs",
          "Reinstall wires in correct firing order",
          "Start engine and check for misfires"
        ],
        "notes": "Autolite 45 or equivalent recommended"
      },
      {
        "operation": "Points and Condenser Replacement",
        "interval": "10,000 miles or as needed",
        "time_estimate": "45 minutes",
        "difficulty": "Moderate",
        "procedure": [
          "Remove distributor cap (2 spring clips)",
          "Note rotor position for reassembly",
          "Remove rotor",
          "Disconnect points wire from terminal",
          "Remove point hold-down screw",
          "Remove old points and condenser",
          "Install new condenser",
          "Install new points, loosely tighten hold-down screw",
          "Set point gap to 0.017\" using feeler gauge",
          "Tighten hold-down screw",
          "Reinstall rotor and cap",
          "Set timing to specification (varies by application)"
        ],
        "notes": "Consider Pertronix electronic conversion to eliminate this maintenance"
      },
      {
        "operation": "Ignition Timing Adjustment",
        "interval": "Annual or after points service",
        "time_estimate": "15 minutes",
        "difficulty": "Easy",
        "procedure": [
          "Warm engine to operating temperature",
          "Connect timing light to #1 spark plug wire",
          "Locate timing marks on harmonic balancer and timing cover",
          "Start engine and set to idle (500-600 RPM)",
          "Disconnect and plug vacuum advance line",
          "Aim timing light at timing marks",
          "Loosen distributor hold-down bolt",
          "Rotate distributor to set initial timing (varies 4-10° BTDC)",
          "Tighten hold-down bolt",
          "Reconnect vacuum advance",
          "Verify timing and no detonation at part throttle"
        ],
        "notes": "Timing specifications vary by year and application"
      },
      {
        "operation": "Valve Adjustment (Solid Cam)",
        "interval": "10,000 miles for solid cam engines",
        "time_estimate": "2 hours",
        "difficulty": "Moderate",
        "procedure": [
          "Remove valve covers",
          "Rotate engine to TDC #1 cylinder (firing stroke)",
          "Adjust intake and exhaust valves on cylinders 1, 4, 5, 8",
          "Rotate engine 360 degrees",
          "Adjust intake and exhaust valves on cylinders 2, 3, 6, 7",
          "Valve lash: Intake 0.015\", Exhaust 0.018\" (cold)",
          "Reinstall valve covers with new gaskets"
        ],
        "notes": "Hydraulic cam engines are self-adjusting"
      },
      {
        "operation": "Cooling System Service",
        "interval": "2 years",
        "time_estimate": "2 hours",
        "difficulty": "Moderate",
        "procedure": [
          "Allow engine to cool completely",
          "Position drain pan under radiator petcock",
          "Open petcock and drain coolant",
          "Remove thermostat housing and thermostat",
          "Inspect thermostat (test in hot water if reusing)",
          "Install new thermostat (jiggle valve up)",
          "Install new thermostat housing gasket",
          "Close petcock",
          "Fill system with 50/50 coolant mix (18 quarts total)",
          "Run engine with heater on until thermostat opens",
          "Top off coolant as air bleeds out",
          "Install radiator cap and verify no leaks"
        ],
        "notes": "Use green ethylene glycol coolant for cast iron engines"
      }
    ],
    "common_repairs": [
      {
        "operation": "Water Pump Replacement",
        "time_estimate": "2-3 hours",
        "difficulty": "Moderate",
        "procedure": [
          "Drain cooling system",
          "Remove fan belt(s)",
          "Remove fan and fan spacer",
          "Remove water pump pulley",
          "Remove water pump bolts",
          "Remove water pump and gasket",
          "Clean gasket surfaces on block",
          "Install new gasket with sealer",
          "Install new water pump",
          "Torque bolts to 15 ft-lbs",
          "Reinstall pulley, fan, and belts",
          "Refill cooling system",
          "Run engine and check for leaks"
        ],
        "parts_required": ["Water pump", "Gasket", "Coolant"],
        "notes": "Inspect thermostat while cooling system is drained"
      },
      {
        "operation": "Valve Cover Gasket Replacement",
        "time_estimate": "1 hour",
        "difficulty": "Easy",
        "procedure": [
          "Remove breather assembly",
          "Remove valve cover bolts",
          "Remove valve covers (may require light tapping)",
          "Clean old gasket material from covers and heads",
          "Install new gaskets (cork or rubber)",
          "Reinstall valve covers",
          "Torque bolts to 3-4 ft-lbs (do not overtorque)",
          "Reinstall breather assembly",
          "Start engine and check for leaks"
        ],
        "parts_required": ["Valve cover gaskets (2)"],
        "notes": "Rubber gaskets are more durable than cork"
      },
      {
        "operation": "Carburetor Rebuild",
        "time_estimate": "3-4 hours",
        "difficulty": "Moderate to Advanced",
        "procedure": [
          "Remove air cleaner assembly",
          "Disconnect fuel line, throttle linkage, choke linkage",
          "Remove carburetor mounting bolts",
          "Remove carburetor and intake manifold gasket",
          "Disassemble carburetor, noting all positions",
          "Clean all metal parts in carburetor cleaner",
          "Replace all gaskets, needle and seat, accelerator pump",
          "Set float level per specifications",
          "Reassemble carburetor",
          "Install carburetor with new gasket",
          "Reconnect all linkages and fuel line",
          "Adjust idle mixture screws (1.5 turns out from seated)",
          "Start engine and adjust idle speed and mixture"
        ],
        "parts_required": ["Carburetor rebuild kit"],
        "notes": "Holley and Carter kits widely available"
      },
      {
        "operation": "Exhaust Manifold Replacement",
        "time_estimate": "3-4 hours per side",
        "difficulty": "Moderate",
        "procedure": [
          "Apply penetrating oil to manifold bolts (let soak)",
          "Disconnect exhaust pipe at manifold flange",
          "Remove exhaust manifold bolts (work from center out)",
          "Remove exhaust manifold (may require significant force)",
          "Clean gasket surfaces on head",
          "Install new gaskets (apply anti-seize to studs)",
          "Install manifold and torque bolts to 25 ft-lbs",
          "Reconnect exhaust pipe",
          "Start engine and check for exhaust leaks"
        ],
        "parts_required": ["Exhaust manifold gaskets", "New hardware if damaged"],
        "notes": "Broken bolts are common - plan for extraction if needed"
      },
      {
        "operation": "Rear Main Seal Replacement (Neoprene Conversion)",
        "time_estimate": "8-12 hours (transmission out)",
        "difficulty": "Advanced",
        "procedure": [
          "Remove transmission (automatic) or transmission and clutch (manual)",
          "Remove flywheel/flexplate",
          "Remove oil pan",
          "Remove rear main cap",
          "Remove old rope seal from cap and block",
          "Clean seal groove thoroughly",
          "Install neoprene seal conversion kit per instructions",
          "Apply assembly lube to seal surface",
          "Reinstall rear main cap, torque to 95 ft-lbs",
          "Reinstall oil pan with new gasket",
          "Reinstall flywheel/flexplate",
          "Reinstall transmission"
        ],
        "parts_required": ["Rear main seal kit (neoprene conversion)", "Oil pan gasket", "Rear main cap bolts"],
        "notes": "Neoprene conversion is far superior to original rope seal"
      },
      {
        "operation": "Electronic Ignition Conversion (Pertronix)",
        "time_estimate": "1-2 hours",
        "difficulty": "Easy",
        "procedure": [
          "Disconnect battery",
          "Remove distributor cap",
          "Remove rotor",
          "Remove points and condenser",
          "Install Pertronix magnetic ring on distributor shaft",
          "Install Pertronix module in place of points",
          "Route wires per instructions",
          "Connect red wire to ignition-on 12V source",
          "Connect black wire to coil negative terminal",
          "Verify no interference with rotating components",
          "Reinstall rotor and cap",
          "Reconnect battery",
          "Start engine and verify operation",
          "Set timing (may need readjustment)"
        ],
        "parts_required": ["Pertronix Ignitor kit (1281 for Y-Block)", "Flame-Thrower coil (optional but recommended)"],
        "notes": "Eliminates point maintenance, improves starting and idle"
      },
      {
        "operation": "12-Volt Alternator Conversion",
        "time_estimate": "4-6 hours",
        "difficulty": "Moderate to Advanced",
        "procedure": [
          "Disconnect and remove battery",
          "Remove generator and voltage regulator",
          "Install alternator mounting bracket",
          "Install alternator (63+ amp recommended)",
          "Route new wiring per kit instructions",
          "Convert ignition system to 12V if needed",
          "Convert lighting and accessories to 12V if needed",
          "Install 12V battery",
          "Connect all wiring per diagram",
          "Start engine and verify charging (13.8-14.5V)",
          "Load test charging system"
        ],
        "parts_required": ["Alternator conversion kit", "12V battery", "12V accessories as needed"],
        "notes": "Essential upgrade for reliable electrical system"
      }
    ],
