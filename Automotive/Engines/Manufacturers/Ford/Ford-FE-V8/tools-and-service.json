  "service_operations": {
    "routine_maintenance": [
      {
        "operation": "Oil Change",
        "interval": "3,000 miles or 3 months",
        "time_estimate": "30 minutes",
        "difficulty": "Easy",
        "procedure": [
          "Warm engine to operating temperature",
          "Position drain pan under oil pan drain plug",
          "Remove drain plug (1/2-20 thread)",
          "Allow complete drainage (10 minutes)",
          "Replace drain plug with new gasket",
          "Remove and replace spin-on oil filter",
          "Add 6 quarts of ZDDP-enhanced oil (10W-40 or 20W-50)",
          "Start engine, check for leaks",
          "Verify oil level on dipstick"
        ],
        "notes": "ZDDP oil essential for flat tappet cam protection"
      },
      {
        "operation": "Spark Plug Replacement",
        "interval": "10,000 miles",
        "time_estimate": "1 hour",
        "difficulty": "Easy",
        "procedure": [
          "Allow engine to cool",
          "Remove spark plug wires one at a time",
          "Use 13/16\" spark plug socket",
          "Inspect old plugs for condition",
          "Gap new plugs to 0.035\"",
          "Install plugs, torque to 25 ft-lbs",
          "Reinstall wires in correct firing order"
        ],
        "notes": "Firing order: 1-5-4-2-6-3-7-8"
      },
      {
        "operation": "Points and Condenser",
        "interval": "10,000 miles",
        "time_estimate": "45 minutes",
        "difficulty": "Moderate",
        "procedure": [
          "Remove distributor cap",
          "Remove rotor",
          "Disconnect points wire",
          "Remove points hold-down screw",
          "Install new points and condenser",
          "Set point gap to 0.017\"",
          "Set dwell to 26-28 degrees",
          "Set timing per specifications"
        ],
        "notes": "Consider Pertronix electronic conversion"
      },
      {
        "operation": "Valve Adjustment (Solid Cam)",
        "interval": "10,000 miles for solid cam",
        "time_estimate": "2-3 hours",
        "difficulty": "Moderate",
        "procedure": [
          "Remove valve covers",
          "Remove rocker arm shaft assemblies",
          "Rotate engine to TDC #1 firing",
          "FE uses shaft-mounted adjustable rockers",
          "Adjust lash: Intake 0.018\", Exhaust 0.020\" (cold)",
          "Reassemble rocker shafts",
          "Reinstall valve covers"
        ],
        "notes": "Hydraulic cam engines are self-adjusting"
      },
      {
        "operation": "Cooling System Service",
        "interval": "2 years",
        "time_estimate": "2 hours",
        "difficulty": "Moderate",
        "procedure": [
          "Allow engine to cool completely",
          "Drain radiator and block",
          "Remove thermostat and inspect",
          "Install new thermostat (jiggle valve up)",
          "Close drains",
          "Fill with 50/50 coolant mix",
          "Run engine until thermostat opens",
          "Top off and bleed air"
        ],
        "notes": "Total capacity approximately 20 quarts"
      }
    ],
