  "service_operations": {
    "routine_maintenance": [
      {
        "operation": "Oil Change",
        "interval": "3,000-5,000 miles",
        "time_estimate": "30 minutes",
        "difficulty": "Easy",
        "procedure": [
          "Warm engine to operating temperature",
          "Remove drain plug and drain oil",
          "Replace oil filter (FL-820S or equivalent)",
          "Replace drain plug",
          "Add 5 quarts of oil (5W-30 for EFI)",
          "Start engine and check for leaks",
          "Verify oil level"
        ],
        "notes": "Synthetic oil recommended for performance"
      },
      {
        "operation": "Spark Plug Replacement",
        "interval": "30,000 miles (platinum) or as needed",
        "time_estimate": "1 hour",
        "difficulty": "Easy",
        "procedure": [
          "Allow engine to cool",
          "Remove spark plug wires one at a time",
          "Remove plugs with 5/8\" socket",
          "Gap new plugs to 0.054\" (EFI)",
          "Install plugs, torque to 15 ft-lbs",
          "Reinstall wires"
        ],
        "notes": "Motorcraft ASF42C or equivalent"
      },
      {
