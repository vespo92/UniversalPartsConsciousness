        "operation": "Fuel Filter Replacement",
        "interval": "30,000 miles",
        "time_estimate": "30 minutes",
        "difficulty": "Easy to Moderate",
        "procedure": [
          "Relieve fuel system pressure",
          "Locate fuel filter (frame rail)",
          "Use disconnect tools to remove lines",
          "Replace filter (note flow direction)",
          "Reconnect lines until they click"
        ],
        "notes": "Always relieve fuel pressure first"
      },
      {
        "operation": "PCV Valve Replacement",
        "interval": "30,000 miles",
        "time_estimate": "5 minutes",
        "difficulty": "Easy",
        "procedure": [
          "Locate PCV valve in valve cover grommet",
          "Pull out old valve",
          "Push in new valve",
          "Verify hose connection"
        ]
      },
      {
        "operation": "Cooling System Flush",
        "interval": "30,000 miles or 2 years",
        "time_estimate": "1-2 hours",
        "difficulty": "Easy",
        "procedure": [
          "Allow engine to cool",
          "Drain radiator via petcock",
          "Remove thermostat housing and thermostat",
          "Flush system with water",
          "Install new thermostat (jiggle valve up)",
          "Close petcock",
          "Fill with 50/50 coolant mix",
          "Run engine and bleed air",
          "Top off coolant"
        ],
        "notes": "14 quarts total capacity for 302"
      }
